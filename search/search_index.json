\u0431\u043b\u0438\u0446\u0435 \u043f\u0440\u0438\u0432\u0435\u0434\u0451\u043d \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u043c\u044b\u0439 \u0430\u0434\u0440\u0435\u0441 / . \u0412 \u0437\u0430\u0434\u0430\u043d\u0438\u044f\u0445 1, 2 \u0438 4 HTTP \u043d\u0435 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u0442\u0441\u044f: \u043e\u0431\u043c\u0435\u043d \u0438\u0434\u0451\u0442 \u043d\u0435\u043f\u043e\u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0435\u043d\u043d\u043e \u043f\u043e UDP \u0438\u043b\u0438 TCP \u043d\u0430 \u043f\u043e\u0440\u0442\u0430\u0445 8001, 8002 \u0438 8004. \u041f\u0440\u043e\u0432\u0435\u0440\u043a\u0430 \u041f\u0440\u043e\u0432\u0435\u0440\u0435\u043d\u044b \u043e\u0431\u043c\u0435\u043d UDP, \u0432\u044b\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044f \u0441 \u0446\u0435\u043b\u044b\u043c\u0438 \u0438 \u0434\u0440\u043e\u0431\u043d\u044b\u043c\u0438 \u0447\u0438\u0441\u043b\u0430\u043c\u0438, \u043f\u043e\u043b\u0443\u0447\u0435\u043d\u0438\u0435 HTML \u0438 \u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0438\u0435 \u0434\u043b\u0438\u043d\u044b \u043e\u0442\u0432\u0435\u0442\u0430. \u0412 \u0447\u0430\u0442\u0435 \u043f\u0440\u043e\u0432\u0435\u0440\u0435\u043d\u044b \u0442\u0440\u0438 \u043f\u043e\u0434\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u044f, \u0440\u0430\u0441\u0441\u044b\u043b\u043a\u0430 \u0441\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u0439 \u0438 \u0432\u044b\u0445\u043e\u0434. \u0414\u043b\u044f \u0436\u0443\u0440\u043d\u0430\u043b\u0430 \u043f\u0440\u043e\u0432\u0435\u0440\u0435\u043d\u044b \u0434\u043e\u0431\u0430\u0432\u043b\u0435\u043d\u0438\u0435 \u0434\u0432\u0443\u0445 \u043e\u0446\u0435\u043d\u043e\u043a \u043e\u0434\u043d\u043e\u043c\u0443 \u043f\u0440\u0435\u0434\u043c\u0435\u0442\u0443 \u0438 \u0433\u0440\u0443\u043f\u043f\u0438\u0440\u043e\u0432\u043a\u0430 \u043f\u043e \u0434\u0438\u0441\u0446\u0438\u043f\u043b\u0438\u043d\u0430\u043c. \u0412\u044b\u0432\u043e\u0434 \u0420